{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TracesToXRayOtlpEndpoint",
      "Effect": "Allow",
      "Action": [
        "xray:PutTraceSegments",
        "xray:PutTelemetryRecords",
        "xray:GetSamplingRules",
        "xray:GetSamplingTargets"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MetricsToCloudWatchOtlpEndpoint",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*"
    },
    {
      "Sid": "ResourceDetectionEksClusterName",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*"
    },
    {
      "Sid": "LogsToCloudWatchLogsOtlpEndpoint",
      "Effect": "Allow",
      "Action": [
        "logs:PutLogEvents",
        "logs:CreateLogStream",
        "logs:DescribeLogStreams",
        "logs:DescribeLogGroups"
      ],
      "Resource": [
        "arn:aws:logs:*:*:log-group:/otel-demo/application",
        "arn:aws:logs:*:*:log-group:/otel-demo/application:*"
      ]
    }
  ]
}
